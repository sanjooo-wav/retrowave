# Supabase: Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Spotify: Developer Dashboard > Settings. Keep the secret server-only.
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
# Must exactly match a Redirect URI registered in Spotify. Use your deployed HTTPS URL.
SPOTIFY_REDIRECT_URI=https://your-domain.com/api/spotify/callback